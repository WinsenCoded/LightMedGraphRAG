# ==============================================================================
# LightMedGraphRAG - Environment Configuration Template
# ==============================================================================

# 1. NLM UMLS Metathesaurus API Key (Daftar gratis di https://uts.nlm.nih.gov/uts/)
UMLS_API_KEY=c9de785e-6034-477d-819d-fab0039f7ab1

# 2. Pemilihan Backend Inferensi LLM:
# Pilihan: 'auto', 'ollama', 'hf', 'groq', 'openai', 'fallback'
LLM_PROVIDER=auto

# 3. Localhost Ollama (Jika menjalankan lokal di laptop/PC)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama-med:latest

# 4. Hugging Face Inference API / Serverless (Untuk Hugging Face Spaces Deployment)
# Dapatkan gratis di https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# 5. Groq Cloud (Inferensi kilat & gratis: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# 6. OpenAI / OpenRouter Compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

